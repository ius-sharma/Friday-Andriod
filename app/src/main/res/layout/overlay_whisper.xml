<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/whisperRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="260dp"
    android:background="@drawable/bg_whisper_bubble"
    android:elevation="14dp"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Sentry Core"
            android:src="@drawable/ic_friday_bubble" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="F.R.I.D.A.Y. • OVERWATCH"
            android:textColor="#FF6D00"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDismissWhisper"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_icon_button_ripple"
            android:contentDescription="Dismiss"
            android:padding="3dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#33FF6D00" />

    <!-- Whisper Speech Text -->
    <TextView
        android:id="@+id/tvWhisperContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:maxLines="5"
        android:text="Sir, ye dekhiye..."
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- In-Call / Incoming Call Interactive Action Row -->
    <LinearLayout
        android:id="@+id/layoutWhisperCallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnWhisperProxyCall"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:text="🤖 FRIDAY BAAT KARO"
            android:textColor="@color/stark_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWhisperAnswerCall"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📞 UTHAO"
            android:textColor="@color/stark_gold"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bio-Fuel / Meal Alert Interactive Action Row -->
    <LinearLayout
        android:id="@+id/layoutWhisperMealActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnWhisperMealDone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:text="✅ KHA LIYA"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWhisperMealSnooze"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="⏳ 15M SNOOZE"
            android:textColor="#FFB300"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
