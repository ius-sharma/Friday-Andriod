<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_friday_hud"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- MAIN SECTION: Left Weather & Right Wave Chart (Directly on AMOLED Glass, No Inner Boxes) -->
    <LinearLayout
        android:id="@+id/layout_widget_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. LEFT SECTION: Image 1 Style Weather & Time (No Box) -->
        <RelativeLayout
            android:id="@+id/layout_weather_pod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <!-- Top Right: Core Status Dot (🟢 ONLINE / ⚪ STANDBY) -->
            <ImageView
                android:id="@+id/dot_widget_core"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="2dp"
                android:contentDescription="Status Dot"
                android:src="@drawable/bg_dot_active" />

            <!-- Main Temperature Row: Weather Icon + Huge Bold Temperature Number -->
            <LinearLayout
                android:id="@+id/layout_temp_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/dot_widget_core"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_widget_weather_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="🌤️"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="26°"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Condition & Location Subtitle (Placed right below temp row) -->
            <TextView
                android:id="@+id/tv_widget_condition_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_temp_row"
                android:layout_alignParentStart="true"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Mainly Clear • Delhi"
                android:textColor="#8E8E93"
                android:textSize="9sp" />

            <!-- Time (Bigger, Placed ABOVE Date - Native Real-time TextClock) -->
            <TextClock
                android:id="@+id/tv_widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/tv_widget_date"
                android:layout_alignParentStart="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFA000"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Bottom: Date (Placed below Time at the bottom edge - Native Real-time TextClock) -->
            <TextClock
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, dd MMM"
                android:format24Hour="EEEE, dd MMM"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#A0A0A0"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Subtle Vertical Separator -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#18FFFFFF"
            android:contentDescription="Divider" />

        <!-- 2. RIGHT SECTION: Unboxed Smooth Wave Chart (scaleType=fitCenter to prevent stretching) -->
        <FrameLayout
            android:id="@+id/layout_chart_pod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:padding="0dp">

            <ImageView
                android:id="@+id/iv_widget_wave_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Forecast Wave Chart"
                android:scaleType="fitCenter" />

        </FrameLayout>

    </LinearLayout>

    <!-- SLIM DIVIDER -->
    <ImageView
        android:id="@+id/divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#2EFF6D00"
        android:contentDescription="Divider" />

    <!-- 3. BOTTOM TELEMETRY ROW: Battery Bar + RAM Bar + Actions -->
    <LinearLayout
        android:id="@+id/layout_widget_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Telemetry module (Clickable to open Friday app) -->
        <LinearLayout
            android:id="@+id/layout_telemetry_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Battery Module -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="⚡ 84%"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_widget_battery"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="44dp"
                    android:layout_height="3.5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="84"
                    android:progressDrawable="@drawable/progress_bar_orange" />
            </LinearLayout>

            <!-- Vertical Separator -->
            <ImageView
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#20FFFFFF"
                android:contentDescription="Sep" />

            <!-- RAM Module -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="💾 4.2 / 8.0 GB"
                    android:textColor="#FF6D00"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_widget_ram"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="44dp"
                    android:layout_height="3.5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="52"
                    android:progressDrawable="@drawable/progress_bar_orange" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fast Refresh Button -->
        <ImageView
            android:id="@+id/btn_widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Refresh"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />

        <!-- Fast Friday Voice Orb Button -->
        <ImageView
            android:id="@+id/btn_widget_voice"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_widget_mic_btn"
            android:contentDescription="Talk to Friday"
            android:padding="5dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>

</LinearLayout>
