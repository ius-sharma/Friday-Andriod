<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="2dp">

    <!-- Glowing Background Aura behind the reactor -->
    <View
        android:id="@+id/bubbleGlow"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:alpha="0.28"
        android:background="@drawable/ic_friday_bubble" />

    <!-- Living Kinetic Arc Reactor Inside the Bubble (Sleek Compact Size) -->
    <com.personal.friday.FridayBubbleReactorView
        android:id="@+id/bubbleReactor"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center" />

    <!-- Pulse Mic Indicator Badge -->
    <ImageView
        android:id="@+id/micBadge"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_button_stark"
        android:padding="2dp"
        android:src="@drawable/ic_mic"
        android:visibility="gone" />

</FrameLayout>